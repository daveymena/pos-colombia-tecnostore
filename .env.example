# Uso propio (desarrollo en esta máquina). Para producción en EasyPanel usa docker-compose.prod.yml
# y la guía docs/DESPLIEGUE_EASYPANEL.md
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos_dev_password
POSTGRES_DB=posdb
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO_DE_AL_MENOS_32_CARACTERES
CORS_ORIGIN=http://localhost:5173
ENABLE_SWAGGER=false
# OpenCode Server interno en EasyPanel; Zen free no permite llamadas directas fuera del servidor.
OPENCODE_SERVER_URL=http://opencode1_oc-zen:4000
# Modelo por defecto: un -free (los más capaces van primero en la rotación)
# o el id de un modelo de pago si la cuenta los tiene.
OPENCODE_MODEL=nemotron-3.5-lightning-free
# Respaldo gratuito: se puede reutilizar la clave Groq que ya usa el bot.
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Solo para el comando manual de bootstrap; quita ADMIN_PASSWORD de EasyPanel después del seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
STORE_NAME=TecnoStore Colombia
STORE_NIT=
SEED_DEMO_CATALOG=false
