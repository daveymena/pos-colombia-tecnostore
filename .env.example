# Uso propio (desarrollo en esta máquina). Para producción en EasyPanel usa docker-compose.prod.yml
# y la guía docs/DESPLIEGUE_EASYPANEL.md
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos_dev_password
POSTGRES_DB=posdb
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO_DE_AL_MENOS_32_CARACTERES
CORS_ORIGIN=http://localhost:5173
ENABLE_SWAGGER=false
# Opcionales; la IA de inventario queda deshabilitada sin clave y nunca modifica existencias.
OPENCODE_API_URL=https://opencode.ai/zen/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash-free
# Solo para el comando manual de bootstrap; quita ADMIN_PASSWORD de EasyPanel después del seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
STORE_NAME=TecnoStore Colombia
STORE_NIT=
SEED_DEMO_CATALOG=false
